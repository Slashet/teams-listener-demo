# ---------------------------------------------------------------------------
# Teams Listener Demo — environment configuration
# Copy to .env and fill in the secrets. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# Public URL of the app. In production, Socket.IO only accepts WebSocket
# connections whose Origin matches this value.
PUBLIC_BASE_URL=https://teamslistener.melihtekin.com

# Number of reverse proxies in front of the app (Nginx Proxy Manager = 1).
TRUST_PROXY=1

# debug | info | warn | error  (transcript text is never logged at any level)
LOG_LEVEL=info

# --- Azure AI Speech --------------------------------------------------------
# The key stays on the server. Browsers only receive short-lived tokens
# from GET /api/speech/token.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_LANGUAGE=tr-TR

# --- WebRTC ICE servers ------------------------------------------------------
# Comma-separated lists are allowed.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.melihtekin.com:3478?transport=udp,turn:turn.melihtekin.com:3478?transport=tcp

# Option A (recommended): shared secret. The app mints time-limited TURN
# credentials per participant; coturn runs with use-auth-secret.
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=21600

# Option B: static long-term credentials (used only if TURN_SHARED_SECRET is
# empty). Note these are delivered to every participant's browser.
TURN_USERNAME=
TURN_PASSWORD=

# --- coturn (docker-compose "coturn" service) -------------------------------
TURN_REALM=turn.melihtekin.com
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Public IP of the server (advertised in relay candidates).
TURN_EXTERNAL_IP=31.40.204.61
# Optional: bind coturn to one interface/IP only.
TURN_LISTENING_IP=
